# RetentionEdit — Environment Variables

# 1. Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 2. Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# 3. Claude Opus (Anthropic) Editorial Intelligence
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-opus-20240229

# 4. Meta Muse Voice Transcribe API (~$0.18/h audio)
META_MUSE_API_KEY=your_meta_muse_api_key_here
# Full file endpoint (verified): POST {BASE}/asr/transcribe, multipart request+audio, WAV uppercase
META_MUSE_ENDPOINT=https://api.meta.ai/v1/asr/transcribe

# 5. Generative AI Images (Higgsfield SOUL v2) — images only, animated in 2.5D
# Verified: POST https://api.higgsfield.ai/higgsfield-ai/soul/v2/standard
# Auth: Authorization: Key <KEY_ID:KEY_SECRET>, flat body (no "input" wrapper, no seed:null)
# Poll: GET https://platform.higgsfield.ai/requests/<id>/status → images[0].url
HIGGSFIELD_API_KEY=your_higgsfield_key_id:your_higgsfield_key_secret

# 5b. AI Voiceover (ElevenLabs text-to-speech) — hook voiceover + dubbing
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# 6. Modal.com Serverless GPU Worker Endpoint
MODAL_RENDER_ENDPOINT=https://your-workspace--retentionedit-gpu-worker-api-render-endpoint.modal.run
MODAL_AUTH_TOKEN=your_modal_auth_token_here

# 7. Storage & Origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 8. Cloudflare R2 (S3-compatible) — Object Storage for user videos
# Bucket unico con prefix per utente: raw/<userId>/... e exports/<userId>/...
# Secrets in vault (server-only), mai esposti al client.
R2_ACCOUNT_ID=your_r2_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET=retentionedit
# Opzionale: custom domain per URL pubblici (altrimenti presigned GET)
R2_PUBLIC_BASE_URL=

# 9. Stripe Payments & Subscriptions (Organization: retentionedit)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Price IDs
STRIPE_PRICE_STARTER_MONTHLY=price_starter_monthly_here
STRIPE_PRICE_STARTER_ANNUAL=price_starter_annual_here
STRIPE_PRICE_PRO_MONTHLY=price_pro_monthly_here
STRIPE_PRICE_PRO_ANNUAL=price_pro_annual_here
STRIPE_PRICE_AGENCY_MONTHLY=price_agency_monthly_here
STRIPE_PRICE_AGENCY_ANNUAL=price_agency_annual_here

# 10. RetentionVolt (creator's own reference DB — 85 analyzed top-performers)
# Read-only match: niche+format → pacing recipe. Own Postgres, ~0 cost/req.
RETENTIONVOLT_URL=https://your-retentionvolt-project.supabase.co
RETENTIONVOLT_ANON_KEY=your_retentionvolt_anon_key_here

