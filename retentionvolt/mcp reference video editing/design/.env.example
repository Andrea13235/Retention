# ==========================================
# Retentionvolt — Environment Template
# Copia questo file in .env (locale) e .env.local (Vercel preview)
# NON committare mai i valori reali — mettili solo su Vercel Dashboard
# ==========================================

# 1. ElevenLabs (Scribe STT)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1

# 2. Supabase (Project: huntczcloqxacakekzvn — Andrea13235's Project)
NEXT_PUBLIC_SUPABASE_URL=https://huntczcloqxacakekzvn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 3. Stripe (test mode ok, live quando sei pronto)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=  # Stripe Dashboard > Developers > Webhooks > Signing secret (whsec_...)

# 4. MCP Server
MCP_API_KEY=            # genera con: openssl rand -hex 16  →  rv_live_<hex>
MCP_ALLOWED_ORIGINS=https://retentionvolt.com,https://www.retentionvolt.com
NEXT_PUBLIC_APP_URL=https://retentionvolt.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 6. ElevenLabs opzionale (se non vuoi STT)
# (lascia vuoto per usare mock locale)

PORT=3000
NODE_ENV=development
