# Admin Dashboard — Secrets Checklist
# HOSTING CONSIGLIATO: NON su /admin del sito pubblico.
# Opzioni in ordine di sicurezza:
#   1) Locale (il tuo Mac) — `npm run dev -p 4001` + SSH tunnel / Tailscale
#   2) Sottodominio privato — admin.retentionvolt.com su progetto Vercel separato con Protection (password/IP allowlist)
#   3) Vercel del sito pubblico MA con middleware + secret forte (meno isolato)
#
# Questo file va solo su Vercel del progetto admin OPPURE in .env.local locale — mai su git.

# [ ] ADMIN_SECRET — genera con: openssl rand -base64 32
#     Esempio: kX9fQ2vT... (32+ char). NESSUN fallback hardcoded.
ADMIN_SECRET=

# [ ] Supabase (stesso progetto, ma usa service_role — admin-only)
NEXT_PUBLIC_SUPABASE_URL=https://huntczcloqxacakekzvn.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# [ ] Stripe (solo read per revenue dashboard)
STRIPE_SECRET_KEY=

# [ ] ElevenLabs (opzionale)
ELEVENLABS_API_KEY=

# [ ] MCP cost
MCP_COST_PER_REQUEST=0.002

PORT=4001
NODE_ENV=production
